<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_light">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#F43F5E"
                android:centerColor="#E11D48"
                android:endColor="#BE123C"
                android:type="linear" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="#FDA4AF" />
        </shape>
    </item>
</ripple>
