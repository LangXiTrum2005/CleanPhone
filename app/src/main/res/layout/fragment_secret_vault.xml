<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_modern_dark">

    <!-- 1. LOCKED VIEW (PIN & Biometric Keypad) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/lockedLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="100dp">

        <ImageView
            android:id="@+id/ivLockIcon"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_circle_icon"
            android:padding="11dp"
            android:src="@drawable/ic_nav_secret"
            app:tint="@color/primary_glow"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvPinTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/secret_pin_title"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivLockIcon" />

        <!-- 6 PIN Dots Indicator -->
        <LinearLayout
            android:id="@+id/pinDotsLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvPinTitle">

            <ImageView
                android:id="@+id/dot1"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginHorizontal="6dp"
                android:src="@drawable/ic_pin_star_empty" />

            <ImageView
                android:id="@+id/dot2"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginHorizontal="6dp"
                android:src="@drawable/ic_pin_star_empty" />

            <ImageView
                android:id="@+id/dot3"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginHorizontal="6dp"
                android:src="@drawable/ic_pin_star_empty" />

            <ImageView
                android:id="@+id/dot4"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginHorizontal="6dp"
                android:src="@drawable/ic_pin_star_empty" />

            <ImageView
                android:id="@+id/dot5"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginHorizontal="6dp"
                android:src="@drawable/ic_pin_star_empty" />

            <ImageView
                android:id="@+id/dot6"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginHorizontal="6dp"
                android:src="@drawable/ic_pin_star_empty" />
        </LinearLayout>

        <!-- Numeric Keypad Grid -->
        <GridLayout
            android:id="@+id/keypadGrid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:columnCount="3"
            android:rowCount="4"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/pinDotsLayout">

            <!-- 1 to 9 buttons created dynamically / styled -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn1"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_margin="6dp"
                android:background="@drawable/bg_circle_icon"
                android:text="1"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                app:backgroundTint="@null" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn2"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_margin="6dp"
                android:background="@drawable/bg_circle_icon"
                android:text="2"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                app:backgroundTint="@null" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn3"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_margin="6dp"
                android:background="@drawable/bg_circle_icon"
                android:text="3"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                app:backgroundTint="@null" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn4"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_margin="6dp"
                android:background="@drawable/bg_circle_icon"
                android:text="4"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                app:backgroundTint="@null" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn5"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_margin="6dp"
                android:background="@drawable/bg_circle_icon"
                android:text="5"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                app:backgroundTint="@null" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn6"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_margin="6dp"
                android:background="@drawable/bg_circle_icon"
                android:text="6"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                app:backgroundTint="@null" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn7"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_margin="6dp"
                android:background="@drawable/bg_circle_icon"
                android:text="7"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                app:backgroundTint="@null" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn8"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_margin="6dp"
                android:background="@drawable/bg_circle_icon"
                android:text="8"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                app:backgroundTint="@null" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn9"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_margin="6dp"
                android:background="@drawable/bg_circle_icon"
                android:text="9"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                app:backgroundTint="@null" />

            <ImageButton
                android:id="@+id/btnBiometric"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_margin="6dp"
                android:background="@drawable/bg_circle_icon"
                android:padding="18dp"
                android:src="@drawable/ic_fingerprint"
                app:tint="@color/accent_cyan" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn0"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_margin="6dp"
                android:background="@drawable/bg_circle_icon"
                android:text="0"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                app:backgroundTint="@null" />

            <ImageButton
                android:id="@+id/btnBackspace"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_margin="6dp"
                android:background="@drawable/bg_circle_icon"
                android:padding="19dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/text_secondary" />
        </GridLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 2. UNLOCKED VAULT VIEW -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/unlockedLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="90dp"
        android:visibility="gone">

        <!-- Top Header -->
        <LinearLayout
            android:id="@+id/vaultTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/secret_title"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnRestoreAll"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_circle_icon"
                android:padding="10dp"
                android:src="@drawable/ic_restore"
                app:tint="@color/accent_emerald" />

            <ImageButton
                android:id="@+id/btnLockVault"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_icon"
                android:padding="10dp"
                android:src="@drawable/ic_nav_secret"
                app:tint="@color/accent_rose" />
        </LinearLayout>

        <!-- Segmented Tabs -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupVault"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            app:singleSelection="true"
            app:layout_constraintTop_toBottomOf="@id/vaultTopBar">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSecretPhotos"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/secret_tab_gallery"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/bg_card"
                app:chipStrokeColor="@color/border_glass" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSecretContacts"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/secret_tab_contacts"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/bg_card"
                app:chipStrokeColor="@color/border_glass" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Vault Content RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvVaultContent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:padding="8dp"
            android:paddingBottom="80dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/chipGroupVault" />

        <!-- Floating Add Button -->
        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fabAddSecret"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            android:backgroundTint="@color/primary"
            android:text="@string/secret_add_media"
            android:textColor="@color/white"
            app:icon="@drawable/ic_image"
            app:iconTint="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Bottom Action Bar for Selected Vault Items -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/vaultBottomActionCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:strokeColor="@color/border_glass"
            app:strokeWidth="1dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvVaultSelectedCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:text="1 selected" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRestoreSelected"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:text="Restore"
                    android:textColor="@color/accent_emerald"
                    app:icon="@drawable/ic_restore"
                    app:iconTint="@color/accent_emerald" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeleteSelectedVault"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="@string/btn_delete"
                    android:textColor="@color/accent_rose"
                    app:icon="@drawable/ic_trash"
                    app:iconTint="@color/accent_rose" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
